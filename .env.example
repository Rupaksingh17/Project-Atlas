# Project Atlas: Environment Configuration

# Service Authentication
API_KEY=atlas-secret-key-2026

# Database Settings (Production MySQL)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=AtlasRoot2026!
DB_NAME=atlas_db

# Dual User Read-Only Credentials (Used by SQL Agent Tool)
READONLY_DB_USER=atlas_readonly
READONLY_DB_PASSWORD=AtlasReadOnly2026!

# LLM Configuration (Options: "openai", "gemini", "mock")
LLM_PROVIDER=mock
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=
GEMINI_API_KEY=

# Thresholds & Timeouts
CONFIDENCE_THRESHOLD=0.80
REQUEST_TIMEOUT_SECONDS=25
