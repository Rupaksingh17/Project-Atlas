# Project Atlas: Environment Configuration

# Copy to .env and replace every CHANGE_ME value with a unique secret.
API_KEY=CHANGE_ME_GENERATE_A_RANDOM_32_BYTE_SECRET
OPS_API_KEY=CHANGE_ME_GENERATE_A_DIFFERENT_RANDOM_32_BYTE_SECRET
CI_ENCRYPTION_KEY=CHANGE_ME_GENERATE_A_RANDOM_32_BYTE_SECRET
MYSQL_ROOT_PASSWORD=CHANGE_ME_GENERATE_A_RANDOM_PASSWORD
DB_PASSWORD=CHANGE_ME_GENERATE_A_RANDOM_PASSWORD
READONLY_DB_PASSWORD=CHANGE_ME_GENERATE_A_RANDOM_PASSWORD

# Database Settings (Production MySQL)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=atlas_app
DB_NAME=atlas_db

# Dual User Read-Only Credentials (Used by SQL Agent Tool)
READONLY_DB_USER=atlas_readonly

# LLM Configuration. Choose OpenAI for hosted inference or Ollama for local inference.
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY is only required when LLM_PROVIDER=openai.
OPENAI_API_KEY=
# With Docker Desktop on Windows, install Ollama on the host and pull the model above.
OLLAMA_BASE_URL=http://host.docker.internal:11434
LLM_TIMEOUT_SECONDS=20
LLM_MAX_OUTPUT_TOKENS=800
# Token prices are required for hosted OpenAI-compatible usage; Ollama runs locally at no API charge.
LLM_INPUT_USD_PER_1M_TOKENS=-1
LLM_OUTPUT_USD_PER_1M_TOKENS=-1
DATASET_LABEL=production
ATLAS_DEMO_MODE=false
ATLAS_CLIENT_SESSION_FIELD=authenticated_client_id
ATLAS_PUBLIC_BASE_URL=/
LOAD_ASSIGNMENT_FIXTURES=false
COOKIE_SECURE=true
REPORTS_HOST_DIR=./production_reports

# Thresholds & Timeouts
CONFIDENCE_THRESHOLD=0.80
REQUEST_TIMEOUT_SECONDS=25
ALLOW_SQLITE_FALLBACK=false
